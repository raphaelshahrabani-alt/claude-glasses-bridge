#!/bin/bash
# Starts everything the glasses need, each in its own Terminal window. Pieces
# that are already running are left alone.
#
#   start-glasses [project-folder] [more-folders...]
#
# Claude Code works in the first folder (default: the current one) and may also
# read and edit the others.
#
# By default the voice is direct: VisionClaw's gateway (the phone logs in
# through it) and glasses-voice, where speech-to-text goes straight to Claude
# Code and its answer is spoken as it is written. GLASSES_VOICE=gemini starts
# the older setup instead: VisionClaw's Gemini worker, which hands requests to
# a separate Claude Code session through the glasses channel.
#
# With the direct voice, a quick model with no tools answers first (Haiku,
# GLASSES_TALK_MODEL) and hands real work to the best one (Opus,
# GLASSES_WORK_MODEL and GLASSES_WORK_EFFORT). The Gemini setup runs its Claude
# Code session on Sonnet at low effort (GLASSES_MODEL, GLASSES_EFFORT). Both
# take GLASSES_PERMISSION_MODE (default auto). If
# ~/.claude-glasses-bridge/persona.md exists (start from
# templates/business-partner.md), Claude Code loads it as extra instructions:
# who you are, your projects, and what it must check with you first.
# GLASSES_PERSONA points at a different file.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
visionclaw="${VISIONCLAW_DIR:-$HOME/VisionClaw}"
voice="${GLASSES_VOICE:-direct}"
project="$(cd "${1:-$PWD}" && pwd)"
if [[ $# -gt 0 ]]; then shift; fi
extra_dirs=()
for dir in "$@"; do
  extra_dirs+=("$(cd "$dir" && pwd)")
done
data_dir="${GLASSES_DATA_DIR:-$HOME/.claude-glasses-bridge}"
persona="${GLASSES_PERSONA:-$data_dir/persona.md}"
model="${GLASSES_MODEL:-sonnet}"
effort="${GLASSES_EFFORT:-low}"
permission_mode="${GLASSES_PERMISSION_MODE:-auto}"
bridge_port="${GLASSES_PORT:-8790}"

die() {
  echo "start-glasses: $*" >&2
  exit 1
}

listening() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# New Terminal window titled $1 running the shell command $2. Both travel as
# arguments, so nothing in them is parsed as AppleScript.
open_window() {
  osascript - "$1" "$2" >/dev/null <<'OSA'
on run argv
  tell application "Terminal"
    activate
    set newTab to do script (item 2 of argv)
    set custom title of newTab to (item 1 of argv)
  end tell
end run
OSA
}

[[ "$voice" == direct || "$voice" == gemini ]] || die "GLASSES_VOICE must be direct or gemini, not $voice"
[[ -d "$visionclaw/gateway" ]] || die "no VisionClaw checkout at $visionclaw (set VISIONCLAW_DIR)"
if [[ "$voice" == gemini ]]; then
  [[ -x "$visionclaw/agent/start.sh" ]] || die "missing $visionclaw/agent/start.sh (see integrations/visionclaw/IPHONE.md, step 5)"
fi
command -v claude >/dev/null || die "claude is not on your PATH"

if listening 8788; then
  echo "gateway: already running"
else
  open_window "glasses: gateway" "$(printf 'cd %q && npm run dev' "$visionclaw/gateway")"
  echo "gateway: started"
fi

if [[ "$voice" == direct ]]; then
  if pgrep -f "voice/worker.py start" >/dev/null; then
    echo "voice:   already running"
  else
    # Settings travel on the command line: the new window doesn't inherit this
    # shell's environment. Only the ones you set: the worker has its own defaults.
    voice_cmd="$(printf 'GLASSES_PROJECT=%q' "$project")"
    for var in GLASSES_TALK_MODEL GLASSES_TALK_EFFORT GLASSES_WORK_MODEL GLASSES_WORK_EFFORT \
      GLASSES_MODEL GLASSES_EFFORT GLASSES_PERMISSION_MODE; do
      if [[ -n "${!var:-}" ]]; then voice_cmd+="$(printf ' %s=%q' "$var" "${!var}")"; fi
    done
    if [[ -n "${extra_dirs[*]+set}" ]]; then
      joined="$(IFS=:; echo "${extra_dirs[*]}")"
      voice_cmd+="$(printf ' GLASSES_ADD_DIRS=%q' "$joined")"
    fi
    if [[ -n "${GLASSES_PERSONA:-}" ]]; then voice_cmd+="$(printf ' GLASSES_PERSONA=%q' "$persona")"; fi
    if [[ -n "${GLASSES_DATA_DIR:-}" ]]; then voice_cmd+="$(printf ' GLASSES_DATA_DIR=%q' "$data_dir")"; fi
    # caffeinate keeps the Mac awake while it runs.
    voice_cmd+="$(printf ' caffeinate -dims %q' "$root/bin/glasses-voice")"
    open_window "glasses: voice" "$voice_cmd"
    echo "voice:   started: you talk straight to Claude Code in $project"
    for dir in ${extra_dirs[@]+"${extra_dirs[@]}"}; do
      echo "         also has access to $dir"
    done
    if [[ -f "$persona" ]]; then echo "         with your profile from $persona"; fi
    echo "         calls are written down in $data_dir/calls/"
  fi
  exit 0
fi

if pgrep -f "voice/worker.py start" >/dev/null; then
  echo "voice:   stopping the direct voice worker, the Gemini worker replaces it"
  pkill -f "voice/worker.py start" || true
fi

if pgrep -f "main.py start" >/dev/null; then
  echo "worker:  already running"
else
  # CLAUDE_CODE_ONLY hides VisionClaw's execute and browse tools, which need
  # keys this setup doesn't have; caffeinate keeps the Mac awake while it runs.
  open_window "glasses: worker" "$(printf 'CLAUDE_CODE_ONLY=1 caffeinate -dims %q' "$visionclaw/agent/start.sh")"
  echo "worker:  started (keeps the Mac awake while it runs)"
fi

# The bridge reads this file when Claude Code starts it.
mkdir -p "$data_dir"
if [[ "${GLASSES_PERMISSION_RELAY:-1}" == 0 ]]; then
  rm -f "$data_dir/permission-relay"
else
  touch "$data_dir/permission-relay"
fi

if listening "$bridge_port"; then
  echo "claude:  a session with the glasses channel is already running"
else
  claude_cmd="$(printf 'cd %q && claude --dangerously-load-development-channels server:glasses --model %q --effort %q --permission-mode %q' \
    "$project" "$model" "$effort" "$permission_mode")"
  for dir in ${extra_dirs[@]+"${extra_dirs[@]}"}; do
    claude_cmd+="$(printf ' --add-dir %q' "$dir")"
  done
  if [[ -f "$persona" ]]; then
    claude_cmd+="$(printf ' --append-system-prompt-file %q' "$persona")"
  fi
  open_window "glasses: claude" "$claude_cmd"
  echo "claude:  started in $project ($model, effort $effort, $permission_mode permissions)"
  for dir in ${extra_dirs[@]+"${extra_dirs[@]}"}; do
    echo "         also has access to $dir"
  done
  if [[ -f "$persona" ]]; then echo "         with your profile from $persona"; fi
  echo "         In its window, choose \"I am using this for local development\"."
fi
