+@function_tool
+async def claude_code(ctx: RunContext[Userdata], task: str, attach_view: bool = False) -> str:
+    """Claude Code, running on the user's own computer with their projects open: answers
+    questions, explains things, reads and edits files and code, runs commands and tests, uses
+    git, and uses any tools the user connected to it. Pass the request in the user's own words,
+    complete, with any earlier context it depends on. Set attach_view=true when the request
+    concerns something the user is showing on camera (a screen, an error message, code, a
+    whiteboard, a document): the current camera frame is then attached so Claude Code can
+    read it."""
+    mode = os.environ.get("ATTACH_VIEW_MODE", "auto")
+    should_attach = attach_view if mode == "auto" else (mode == "always")
+    image_b64 = encode_latest_frame(ctx.userdata.frames) if should_attach else None
+    logger.info(
+        "claude_code start: user=%s attach_view=%s image_kb=%d task=%r",
+        ctx.userdata.user_id, attach_view, len(image_b64 or "") * 3 // 4096, task[:200],
+    )
+    ctx.userdata.tracer.emit("agent_action", tool="claude_code", task=task, attached_view=bool(image_b64))
+    job = asyncio.ensure_future(_claude_code_execute(task, image_b64))
+    return await _run_delegated(ctx, task, "claude_code", job)
+
