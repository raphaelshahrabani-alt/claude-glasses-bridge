+# Camera on demand: a voice-only glasses call publishes no video until the
+# assistant needs to look. The worker then asks the phone to wake the glasses
+# camera (the "vc.camera" text-stream topic), takes one settled frame, and turns
+# the camera off again, so the capture light is on for seconds instead of the
+# whole call. A call that streams video all along never reaches the wake path.
+CAMERA_WAKE_S = 12
+CAMERA_SETTLE_S = 0.8
+
+
+async def _camera_command(room: rtc.Room, on: bool) -> None:
+    try:
+        await room.local_participant.send_text("on" if on else "off", topic="vc.camera")
+    except Exception:
+        logger.exception("camera %s request failed", "on" if on else "off")
+
+
+async def _look(ctx: RunContext[Userdata]) -> str | None:
+    """The current camera frame as base64 JPEG, waking the camera for it when
+    no frame is flowing."""
+    holder = ctx.userdata.frames
+    room = ctx.userdata.room
+    if room is None or (holder.frame is not None and time.time() - holder.arrived_at < 2):
+        return encode_latest_frame(holder)
+    asked_at = time.time()
+    await _camera_command(room, True)
+    try:
+        deadline = time.monotonic() + CAMERA_WAKE_S
+        while time.monotonic() < deadline:
+            if holder.frame is not None and holder.arrived_at > asked_at:
+                # The first frames after waking are often dark while exposure settles.
+                await asyncio.sleep(CAMERA_SETTLE_S)
+                return encode_latest_frame(holder)
+            await asyncio.sleep(0.2)
+        logger.warning("camera did not wake within %ss", CAMERA_WAKE_S)
+        return None
+    finally:
+        await _camera_command(room, False)
+
