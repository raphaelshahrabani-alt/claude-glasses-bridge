+# Camera on demand: a voice-only glasses call publishes no video until the
+# assistant needs to look. The worker then asks the phone to wake the glasses
+# camera (the "vc.camera" text-stream topic), takes one settled frame, and turns
+# the camera off again, so the capture light is on for seconds instead of the
+# whole call. A call that streams video all along never reaches the wake path.
+CAMERA_WAKE_S = 12
+CAMERA_SETTLE_S = 0.8
+
+
+async def _camera_command(room: rtc.Room, on: bool) -> None:
+    try:
+        await room.local_participant.send_text("on" if on else "off", topic="vc.camera")
+    except Exception:
+        logger.exception("camera %s request failed", "on" if on else "off")
+
+
+async def _look(ctx: RunContext[Userdata]) -> str | None:
+    """The current camera frame as base64 JPEG, waking the camera for it when
+    no frame is flowing."""
+    holder = ctx.userdata.frames
+    room = ctx.userdata.room
+    if room is None or (holder.frame is not None and time.time() - holder.arrived_at < 2):
+        return encode_latest_frame(holder)
+    asked_at = time.time()
+    await _camera_command(room, True)
+    try:
+        deadline = time.monotonic() + CAMERA_WAKE_S
+        while time.monotonic() < deadline:
+            if holder.frame is not None and holder.arrived_at > asked_at:
+                # The first frames after waking are often dark while exposure settles.
+                await asyncio.sleep(CAMERA_SETTLE_S)
+                return encode_latest_frame(holder)
+            await asyncio.sleep(0.2)
+        logger.warning("camera did not wake within %ss", CAMERA_WAKE_S)
+        return None
+    finally:
+        await _camera_command(room, False)
+
+
+@function_tool
+async def claude_code(ctx: RunContext[Userdata], task: str, attach_view: bool = False) -> str:
+    """Claude Code, running on the user's own computer with their projects open: answers
+    questions, explains things, reads and edits files and code, runs commands and tests, uses
+    git, and uses any tools the user connected to it. Pass the request in the user's own words,
+    complete, with any earlier context it depends on. Set attach_view=true when the user asks
+    you to look, or the request concerns something in front of them (a screen, an error
+    message, code, a whiteboard, a document): a picture from the camera is then attached,
+    waking the camera for it if it is off, so Claude Code can read it."""
+    mode = os.environ.get("ATTACH_VIEW_MODE", "auto")
+    should_attach = attach_view if mode == "auto" else (mode == "always")
+    image_b64 = await _look(ctx) if should_attach else None
+    logger.info(
+        "claude_code start: user=%s attach_view=%s image_kb=%d task=%r",
+        ctx.userdata.user_id, attach_view, len(image_b64 or "") * 3 // 4096, task[:200],
+    )
+    ctx.userdata.tracer.emit("agent_action", tool="claude_code", task=task, attached_view=bool(image_b64))
+    job = asyncio.ensure_future(_claude_code_execute(task, image_b64))
+    return await _run_delegated(ctx, task, "claude_code", job)
+
