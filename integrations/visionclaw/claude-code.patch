+  /// Set by StreamSessionView, which owns the glasses stream: called with true
+  /// when the agent wants to look through the glasses, false when it is done.
+  var onCameraRequest: ((Bool) -> Void)?
+  private var cameraOffTask: Task<Void, Never>?
+
+  /// Glasses camera on demand: the agent sends "on" on the "vc.camera" topic
+  /// when it needs a picture and "off" once it has one.
+  private func registerCameraHandler() {
+    Task { [weak self] in
+      guard let room = self?.room else { return }
+      try? await room.registerTextStreamHandler(for: "vc.camera") { [weak self] reader, _ in
+        let command = try await reader.readAll()
+        await self?.handleCameraCommand(command)
+      }
+    }
+  }
+
+  private func handleCameraCommand(_ command: String) {
+    let on = command.trimmingCharacters(in: .whitespacesAndNewlines) == "on"
+    NSLog("[LiveKit] agent asked to turn the glasses camera %@", on ? "on" : "off")
+    cameraOffTask?.cancel()
+    cameraOffTask = nil
+    if on {
+      // If the "off" never arrives (the worker restarted, the network dropped),
+      // turn the camera off anyway rather than leave the light on.
+      cameraOffTask = Task { [weak self] in
+        try? await Task.sleep(nanoseconds: 20_000_000_000)
+        guard !Task.isCancelled else { return }
+        self?.cameraOffTask = nil
+        self?.onCameraRequest?(false)
+      }
+    }
+    onCameraRequest?(on)
+  }
+
