+def _claude_code_headers() -> dict[str, str]:
+    return {"Authorization": f"Bearer {os.environ['CLAUDE_CODE_TOKEN']}"}
+
+
+async def _claude_code_execute(task: str, image_b64: str | None = None) -> str:
+    payload: dict = {"messages": [{"role": "user", "content": task}]}
+    if image_b64:
+        payload["image"] = image_b64
+    async with aiohttp.ClientSession() as http:
+        async with http.post(
+            f"{CLAUDE_CODE_URL}/v1/chat/completions",
+            headers=_claude_code_headers(),
+            json=payload,
+            timeout=aiohttp.ClientTimeout(total=120),
+        ) as resp:
+            body = await resp.json()
+    try:
+        return body["choices"][0]["message"]["content"]
+    except (KeyError, IndexError):
+        logger.warning("claude code bridge returned unexpected shape: %s", json.dumps(body)[:300])
+        return "The Claude Code bridge returned an unexpected response."
+
+
+async def _drain_claude_code_pending() -> list[str]:
+    """Claude Code answers that landed after the call stopped waiting for them."""
+    if not CLAUDE_CODE_URL:
+        return []
+    try:
+        async with aiohttp.ClientSession() as http:
+            async with http.get(
+                f"{CLAUDE_CODE_URL}/pending-notifications",
+                headers=_claude_code_headers(),
+                timeout=aiohttp.ClientTimeout(total=10),
+            ) as resp:
+                body = await resp.json()
+        return [f"A Claude Code task from earlier finished. Result: {n}" for n in body.get("notifications") or []]
+    except Exception:
+        logger.exception("claude code pending drain failed")
+        return []
+
